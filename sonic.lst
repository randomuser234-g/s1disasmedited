(1) 2076/   8EE4C :                     ; PSG Note Values: c-1 to a-6
(1) 2077/   8EE4C :                     ;
(1) 2078/   8EE4C :                     ; Each row is an octave, starting with C and ending with B. Sonic 3's driver
(1) 2079/   8EE4C :                     ; adds another octave at the start, as well as two more notes and the end to
(1) 2080/   8EE4C :                     ; complete the last octave. Notably, a-6 is changed from 223721.56Hz to
(1) 2081/   8EE4C :                     ; 6991.28Hz. These changes need to be applied here in order for ports of
(1) 2082/   8EE4C :                     ; songs from Sonic 3 and later to sound correct.
(1) 2083/   8EE4C :                     ;
(1) 2084/   8EE4C :                     ; Here is what Sonic 3's version of this table looks like:
(1) 2085/   8EE4C :                     ;		MakePSGFrequencies  109.34,    109.34,    109.34,    109.34,    109.34,    109.34,    109.34,    109.34,    109.34,    110.20,    116.76,    123.73
(1) 2086/   8EE4C :                     ;		MakePSGFrequencies  130.98,    138.78,    146.99,    155.79,    165.22,    174.78,    185.19,    196.24,    207.91,    220.63,    233.52,    247.47
(1) 2087/   8EE4C :                     ;		MakePSGFrequencies  261.96,    277.56,    293.59,    311.58,    329.97,    349.56,    370.39,    392.49,    415.83,    440.39,    468.03,    494.95
(1) 2088/   8EE4C :                     ;		MakePSGFrequencies  522.71,    556.51,    588.73,    621.44,    661.89,    699.12,    740.79,    782.24,    828.59,    880.79,    932.17,    989.91
(1) 2089/   8EE4C :                     ;		MakePSGFrequencies 1045.42,   1107.52,   1177.47,   1242.89,   1316.00,   1398.25,   1491.47,   1575.50,   1669.55,   1747.82,   1864.34,   1962.46
(1) 2090/   8EE4C :                     ;		MakePSGFrequencies 2071.49,   2193.34,   2330.42,   2485.78,   2601.40,   2796.51,   2943.69,   3107.23,   3290.01,   3495.64,   3608.40,   3857.25
