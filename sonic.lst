     792/     D4A :                     		; The following code handles an awkward visual glitch for the LZ water surface.
     793/     D4A :                     		; If the surface is near the top of the screen (within 96 pixels), the VDP would not have
     794/     D4A :                     		; enough time to do all the transfers in VBla_UpdateScreen before the palette needs to get
     795/     D4A :                     		; changed for the water. Without this special check, the water surface would violently flicker
     796/     D4A :                     		; whenever it's near the top of the screen. It's a rather dirty workaround, but it works.
     797/     D4A : 0C38 0060 F625      		cmpi.b	#96,(v_hbla_line).w		; is LZ water surface within 96 pixels of the top of the screen?
     798/     D50 : 640C                		bhs.s	VBla_UpdateScreen		; if not, do screen updates now
     799/     D52 : 11FC 0001 F64F      		move.b	#1,(f_doupdatesinhblank).w	; otherwise, we don't have enough time to do them now before HBlank hits, defer updates to then
     800/     D58 : 588F                		addq.l	#4,sp				; skip return address (i.e. postpone updating the sound driver as well)
     801/     D5A : 6000 FE0E           		bra.w	VBla_Exit			; go straight back to to the VBlank exit
     802/     D5E :                     
