    2784/    3A80 :                     ; Subroutine to load level select text
    2785/    3A80 :                     ; ---------------------------------------------------------------------------
    2786/    3A80 :                     
    2787/    3A80 : =$15                 levsel_line_count:	equ 21	; total number of lines
    2788/    3A80 : =$18                 levsel_line_length:	equ 24	; characters per line
    2789/    3A80 : =$14                 levsel_sndtest_row:	equ levsel_line_count-1  ; row index of the sound test
    2790/    3A80 : =$10                 levsel_sndtest_col:	equ levsel_line_length-8 ; column offset for the sound test number 
    2791/    3A80 :                     
    2792/    3A80 : =$4                  levsel_start_row:	equ 4	; top tile offset for start position
    2793/    3A80 : =$8                  levsel_start_col:	equ 8	; left tile offset for start position
    2794/    3A80 : =$E210               levsel_vram_main:	equ vram_bg+(levsel_start_row<<7)+(levsel_start_col<<1)	; nametable address in VRAM
    2795/    3A80 : =$EC30               levsel_vram_sndtestnum:	equ levsel_vram_main+(levsel_sndtest_row<<7)+(levsel_sndtest_col<<1) ; nametable address for sound test numbers
    2796/    3A80 :                     
    2797/    3A80 : =$E680               levsel_white:		equ make_art_tile(ArtTile_Level_Select_Font,3,TRUE) ; VRAM setting for white text (non-selected lines)
    2798/    3A80 : =$C680               levsel_yellow:		equ make_art_tile(ArtTile_Level_Select_Font,2,TRUE) ; VRAM setting for yellow text (selected line)
