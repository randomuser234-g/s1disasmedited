(1)  184/    17B8 :                     		
(1)  185/    17B8 : 1200                		move.b	d0,d1
(1)  186/    17BA : 0247 000F           		andi.w	#$F,d7	; get palette index
(1)  187/    17BE : 0241 0070           		andi.w	#$70,d1	; get repeat count for palette index
(1)  188/    17C2 : 8E41                		or.w	d1,d7	; combine the two
(1)  189/    17C4 : 0240 000F           		andi.w	#$F,d0	; get the length of the code in bits
(1)  190/    17C8 : 1200                		move.b	d0,d1
(1)  191/    17CA : E149                		lsl.w	#8,d1
(1)  192/    17CC : 8E41                		or.w	d1,d7	; combine with palette index and repeat count to form code table entry
(1)  193/    17CE : 7208                		moveq	#8,d1
(1)  194/    17D0 : 9240                		sub.w	d0,d1	; is the code 8 bits long?
(1)  195/    17D2 : 660A                		bne.s	NemBCT_ShortCode	; if not, a bit of extra processing is needed
(1)  196/    17D4 : 1018                		move.b	(a0)+,d0	; get code
(1)  197/    17D6 : D040                		add.w	d0,d0	; each code gets a word-sized entry in the table
(1)  198/    17D8 : 3387 0000           		move.w	d7,(a1,d0.w)	; store the entry for the code
(1)  199/    17DC : 60D2                		bra.s	NemBCT_Loop	; repeat
(1)  200/    17DE :                     ; ===========================================================================
(1)  201/    17DE :                     
(1)  202/    17DE :                     ; the Nemesis decompressor uses prefix-free codes (no valid code is a prefix of a longer code)
(1)  203/    17DE :                     ; e.g. if 10 is a valid 2-bit code, 110 is a valid 3-bit code but 100 isn't
(1)  204/    17DE :                     ; also, when the actual compressed data is processed the high bit of each code is in bit position 7
(1)  205/    17DE :                     ; so the code needs to be bit-shifted appropriately over here before being used as a code table index
(1)  206/    17DE :                     ; additionally, the code needs multiple entries in the table because no masking is done during compressed data processing
(1)  207/    17DE :                     ; so if 11000 is a valid code then all indices of the form 11000XXX need to have the same entry
(1)  208/    17DE :                     NemBCT_ShortCode:
(1)  209/    17DE : 1018                		move.b	(a0)+,d0	; get code
(1)  210/    17E0 : E368                		lsl.w	d1,d0	; get index into code table
(1)  211/    17E2 : D040                		add.w	d0,d0	; shift so that high bit is in bit position 7
(1)  212/    17E4 : 7A01                		moveq	#1,d5
(1)  213/    17E6 : E36D                		lsl.w	d1,d5
(1)  214/    17E8 : 5345                		subq.w	#1,d5	; d5 = 2^d1 - 1
(1)  215/    17EA :                     
(1)  216/    17EA :                     NemBCT_ShortCode_Loop:
(1)  217/    17EA : 3387 0000           		move.w	d7,(a1,d0.w)	; store entry
(1)  218/    17EE : 5440                		addq.w	#2,d0	; increment index
(1)  219/    17F0 : 51CD FFF8           		dbf	d5,NemBCT_ShortCode_Loop	; repeat for required number of entries
(1)  220/    17F4 : 60BA                		bra.s	NemBCT_Loop
(1)  221/    17F6 :                     ; End of function NemDec_BuildCodeTable
