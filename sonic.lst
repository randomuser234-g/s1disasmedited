    1104/    121A :                     VDPSetupArray_End:
    1105/    121A :                     		include	"_inc/DMA-Queue.asm"
(1)    1/    121A :                     ; ---------------------------------------------------------------------------
(1)    2/    121A :                     ; MACRO ResetDMAQueue
(1)    3/    121A :                     ; Clears the DMA queue, discarding all previously-queued DMAs.
(1)    4/    121A :                     ; ---------------------------------------------------------------------------
(1)    5/    121A :                     ; ROUTINE Process_DMA_Queue / ProcessDMAQueue
(1)    6/    121A :                     ; Performs all queued DMA transfers and clears the DMA queue.
(1)    7/    121A :                     ;
(1)    8/    121A :                     ; Output:
(1)    9/    121A :                     ; 	a1,a5	trashed
(1)   10/    121A :                     ; ---------------------------------------------------------------------------
(1)   11/    121A :                     ; ROUTINE InitDMAQueue
(1)   12/    121A :                     ; Pre-initializes the DMA queue with VDP register numbers in alternating bytes.
(1)   13/    121A :                     ; Must be called before the queue is used, and the queue expects that only it
(1)   14/    121A :                     ; write to this region of RAM.
(1)   15/    121A :                     ;
(1)   16/    121A :                     ; Output:
(1)   17/    121A :                     ; 	a0,d0,d1	trashed
(1)   18/    121A :                     ; ---------------------------------------------------------------------------
(1)   19/    121A :                     ; ROUTINE Add_To_DMA_Queue / QueueDMATransfer
(1)   20/    121A :                     ; Queues a DMA with parameters given in registers.
(1)   21/    121A :                     ;
(1)   22/    121A :                     ; Options:
(1)   23/    121A :                     ; 	AssumeSourceAddressInBytes (default 1)
(1)   24/    121A :                     ; 	AssumeSourceAddressIsRAMSafe (default 0)
(1)   25/    121A :                     ; 	UseRAMSourceSafeDMA (default 1&(AssumeSourceAddressIsRAMSafe==0))
(1)   26/    121A :                     ; 	Use128kbSafeDMA (default 0)
(1)   27/    121A :                     ; 	UseVIntSafeDMA (default 0)
(1)   28/    121A :                     ; Input:
(1)   29/    121A :                     ; 	d1	Source address (in bytes, or in words if AssumeSourceAddressInBytes is
(1)   30/    121A :                     ; 		set to 0)
(1)   31/    121A :                     ; 	d2	Destination address
(1)   32/    121A :                     ; 	d3	Transfer length (in words)
(1)   33/    121A :                     ; Output:
(1)   34/    121A :                     ; 	d0,d1,d2,d3,a1	trashed
(1)   35/    121A :                     ;
(1)   36/    121A :                     ; With the default settings, runs in:
(1)   37/    121A :                     ; * 48(11/0) cycles if queue is full (DMA discarded)
(1)   38/    121A :                     ; * 184(29/9) cycles otherwise (DMA queued)
(1)   39/    121A :                     ;
(1)   40/    121A :                     ; With Use128kbSafeDMA = 1, runs in:
(1)   41/    121A :                     ; * 48(11/0) cycles if queue is full at the start (DMA discarded)
(1)   42/    121A :                     ; * 200(32/9) cycles if the DMA does not cross a 128kB boundary (DMA queued)
(1)   43/    121A :                     ; * 226(38/9) cycles if the DMA crosses a 128kB boundary, and the first piece
(1)   44/    121A :                     ;   fills the queue (second piece is discarded)
(1)   45/    121A :                     ; * 338(56/17) cycles if the DMA crosses a 128kB boundary, and the queue has
(1)   46/    121A :                     ;   space for both pieces (both pieces queued)
(1)   47/    121A :                     ;
(1)   48/    121A :                     ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to all times.
(1)   49/    121A :                     ;
(1)   50/    121A :                     ; Setting AssumeSourceAddressInBytes to 0 reduces all times by 10(1/0) cycles,
(1)   51/    121A :                     ; but only if the DMA is not entirely discarded. However, all callers must be
(1)   52/    121A :                     ; edited to make sure the adresss given is in the correct form; you can use
(1)   53/    121A :                     ; the dmaSource function for that, which also sanitizes RAM addresses.
(1)   54/    121A :                     ;
(1)   55/    121A :                     ; Setting AssumeSourceAddressIsRAMSafe to 1, or UseRAMSourceSafeDMA to 0,
(1)   56/    121A :                     ; reduces all times by 14(2/0) cycles, but only if the DMA is not entirely
(1)   57/    121A :                     ; discarded. However, all callers must be edited to make sure the adresss given
(1)   58/    121A :                     ; in the correct form.
(1)   59/    121A :                     ; ---------------------------------------------------------------------------
(1)   60/    121A :                     ; MACRO QueueStaticDMA
(1)   61/    121A :                     ; Directly queues a DMA on the spot. Requires all parameters to be known at
(1)   62/    121A :                     ; assembly time; that is, no registers. Gives assembly errors when the DMA
(1)   63/    121A :                     ; crosses a 128kB boundary, is at an odd ROM location, or is zero length.
(1)   64/    121A :                     ;
(1)   65/    121A :                     ; The destination parameter can be either:
(1)   66/    121A :                     ; * a VRAM address literal;
(1)   67/    121A :                     ; * a register initialized with `move.l	#vdpComm(dest,VRAM,DMA)`
(1)   68/    121A :                     ; * a register initialized with `vdpCommReg <reg>,VRAM,DMA`
(1)   69/    121A :                     ;
(1)   70/    121A :                     ; Options:
(1)   71/    121A :                     ; 	UseVIntSafeDMA (default 0)
(1)   72/    121A :                     ; Input:
(1)   73/    121A :                     ; 	Source address (in bytes), transfer length (in bytes), destination address
(1)   74/    121A :                     ; Output:
(1)   75/    121A :                     ; 	d0,a1	trashed; avoid using these for passing destination as a register
(1)   76/    121A :                     ;
(1)   77/    121A :                     ; With the default settings, runs in:
(1)   78/    121A :                     ; * 32(7/0) cycles if queue is full (DMA discarded)
(1)   79/    121A :                     ; * 122(21/8) cycles otherwise (DMA queued)
(1)   80/    121A :                     ; Passing a register as destination is faster by 8(2/0) when the DMA is queued,
(1)   81/    121A :                     ; but requires initializing the register elsewhere, which is probably slower.
(1)   82/    121A :                     ;
(1)   83/    121A :                     ; Setting UseVIntSafeDMA to 1 adds 46(6/1) cycles to both cases.
(1)   84/    121A :                     ; ===========================================================================
(1)   85/    121A :                     ; option: AssumeSourceAddressInBytes
(1)   86/    121A :                     ;
(1)   87/    121A :                     ; This option makes the function work as a drop-in replacement of the original
(1)   88/    121A :                     ; functions. If you modify all callers to supply a position in words instead of
(1)   89/    121A :                     ; bytes (i.e., divide source address by 2) you can set this to 0 to gain 10(1/0)
(1)   90/    121A : =$1                  AssumeSourceAddressInBytes = 1
(1)   91/    121A :                     ; ===========================================================================
(1)   92/    121A :                     ; option: AssumeSourceAddressIsRAMSafe
(1)   93/    121A :                     ;
(1)   94/    121A :                     ; This option (which is disabled by default) makes the DMA queue assume that the
(1)   95/    121A :                     ; source address is given to the function in a way that makes them safe to use
(1)   96/    121A :                     ; with RAM sources. You need to edit all callers to ensure this.
(1)   97/    121A :                     ; Enabling this option turns off UseRAMSourceSafeDMA, and saves 14(2/0).
(1)   98/    121A : =$0                  AssumeSourceAddressIsRAMSafe = 0
(1)   99/    121A :                     ; ===========================================================================
(1)  100/    121A :                     ; option: UseRAMSourceSafeDMA
(1)  101/    121A :                     ;
(1)  102/    121A :                     ; This option (which is enabled by default) makes source addresses in RAM safe
(1)  103/    121A :                     ; at the cost of 14(2/0). If you modify all callers so as to clear the top byte
(1)  104/    121A :                     ; of source addresses (i.e., by ANDing them with $FFFFFF).
(1)  105/    121A : =$1                  UseRAMSourceSafeDMA = 1&(AssumeSourceAddressIsRAMSafe==0)
(1)  106/    121A :                     ; ===========================================================================
(1)  107/    121A :                     ; option: Use128kbSafeDMA
(1)  108/    121A :                     ;
(1)  109/    121A :                     ; This option breaks DMA transfers that crosses a 128kB block into two. It is
(1)  110/    121A :                     ; disabled by default because you can simply align the art in ROM and avoid the
(1)  111/    121A :                     ; issue altogether. It is here so that you have a high-performance routine to do
(1)  112/    121A :                     ; the job in situations where you can't align it in ROM.
(1)  113/    121A : =$0                  Use128kbSafeDMA = 0
(1)  114/    121A :                     ; ===========================================================================
(1)  115/    121A :                     ; option UseVIntSafeDMA
(1)  116/    121A :                     ;
(1)  117/    121A :                     ; Option to mask interrupts while updating the DMA queue. This fixes many race
(1)  118/    121A :                     ; conditions in the DMA funcion, but it costs 46(6/1) cycles. The better way to
(1)  119/    121A :                     ; handle these race conditions would be to make unsafe callers (such as S3&K's
(1)  120/    121A :                     ; KosM decoder) prevent these by masking off interrupts before calling and then
(1)  121/    121A :                     ; restore interrupts after.
(1)  122/    121A : =$0                  UseVIntSafeDMA = 0
(1)  123/    121A :                     ; ===========================================================================
(1)  124/    121A :                     ; Convenience macros, for increased maintainability of the code.
(1)  126/    121A : =$27                 		equ	DMA,%100111
(1)  129/    121A : =$21                 		equ	VRAM,%100001
(1)  132/    121A :                     ; Like vdpComm, but starting from an address contained in a register
(1)  133/    121A : =$1                  vdpCommReg_defined = 1
(1)  134/    121A :                     vdpCommReg macro reg,type,rwd,clr
