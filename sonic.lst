(1) 2682/   90A66 :                     ; ---------------------------------------------------------------------------
(1) 2683/   90A66 :                     ; SMPS2ASM - A collection of macros that make SMPS's bytecode human-readable.
(1) 2684/   90A66 :                     ; ---------------------------------------------------------------------------
(1) 2685/   90A66 : =$1                  FixMusicAndSFXDataBugs = FixBugs
(1) 2686/   90A66 : =$1                  SonicDriverVer = 1 ; Tell SMPS2ASM that we're using Sonic 1's driver.
(1) 2687/   90A66 :                     		include "sound/_smps2asm_inc.asm"
