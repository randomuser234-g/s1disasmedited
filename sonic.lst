    8714/   8DD90 :                     
    8715/   8DD90 :                     SoundDriver:	include "s1.sounddriver.asm"
(1)    1/   8DD90 :                     ; ---------------------------------------------------------------------------
(1)    2/   8DD90 :                     ; Modified SMPS 68k Type 1b sound driver
(1)    3/   8DD90 :                     ; The source code to a similar version of the driver can be found here:
(1)    4/   8DD90 :                     ; https://hiddenpalace.org/News/Sega_of_Japan_Sound_Documents_and_Source_Code
(1)    5/   8DD90 :                     ; ---------------------------------------------------------------------------
(1)    6/   8DD90 :                     ; Constants
(1)    7/   8DD90 : =$12                 SMPS_TRACK_COUNT = (SMPS_RAM.v_track_ram_end-SMPS_RAM.v_track_ram)/SMPS_Track.len
(1)    8/   8DD90 : =$A                  SMPS_MUSIC_TRACK_COUNT = (SMPS_RAM.v_music_track_ram_end-SMPS_RAM.v_music_track_ram)/SMPS_Track.len
(1)    9/   8DD90 : =$7                  SMPS_MUSIC_FM_DAC_TRACK_COUNT = (SMPS_RAM.v_music_fmdac_tracks_end-SMPS_RAM.v_music_fmdac_tracks)/SMPS_Track.len
(1)   10/   8DD90 : =$6                  SMPS_MUSIC_FM_TRACK_COUNT = (SMPS_RAM.v_music_fm_tracks_end-SMPS_RAM.v_music_fm_tracks)/SMPS_Track.len
