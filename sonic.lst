(2)  825/   90A66 :                     	eval vcCF1,op1
(2)  826/   90A66 :                     	eval vcCF2,op2
(2)  827/   90A66 :                     	eval vcCF3,op3
(2)  828/   90A66 :                     	eval vcCF4,op4
