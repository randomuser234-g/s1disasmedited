(1)  195/    121A :                     ; Expects source address and DMA length in bytes. Also, expects source, size, and dest to be known
(1)  196/    121A :                     ; at assembly time. Gives errors if DMA starts at an odd address, transfers
(1)  197/    121A :                     ; crosses a 128kB boundary, or has size 0.
(1)  198/    121A :                     QueueStaticDMA macro src,length,dest
(1)  199/    121A :                     	if MOMPASS>1
(1)  200/    121A :                     		if ((src)&1)<>0
(1)  201/    121A :                     			fatal "DMA queued from odd source $\{src}!"
(1)  202/    121A :                     		endif
(1)  203/    121A :                     		if ((length)&1)<>0
(1)  204/    121A :                     			fatal "DMA an odd number of bytes $\{length}!"
(1)  205/    121A :                     		endif
(1)  206/    121A :                     		if (length)==0
(1)  207/    121A :                     			fatal "DMA transferring 0 bytes (becomes a 128kB transfer). If you really mean it, pass 128kB instead."
(1)  208/    121A :                     		endif
(1)  209/    121A :                     		if (((src)+(length)-1)>>17)<>((src)>>17)
(1)  210/    121A :                     			fatal "DMA crosses a 128kB boundary. You should either split the DMA manually or align the source adequately."
(1)  211/    121A :                     		endif
(1)  212/    121A :                     	endif
(1)  213/    121A :                     	if UseVIntSafeDMA==1
(1)  214/    121A :                     		move.w	sr,-(sp)										; Save current interrupt mask
(1)  215/    121A :                     		disableInts												; Mask off interrupts
(1)  216/    121A :                     	endif ; UseVIntSafeDMA==1
(1)  217/    121A :                     	movea.w	(VDP_Command_Buffer_Slot).w,a1
(1)  218/    121A :                     	cmpa.w	#VDP_Command_Buffer_Slot,a1
(1)  219/    121A :                     	beq.s	.done												; Return if there's no more room in the buffer
(1)  220/    121A :                     	move.b	#(dmaLength(length)>>8)&$FF,DMAEntry.SizeH(a1)		; Write top byte of size/2
(1)  221/    121A :                     	move.l	#((dmaLength(length)&$FF)<<24)|dmaSource(src),d0	; Set d0 to bottom byte of size/2 and the low 3 bytes of source/2
(1)  222/    121A :                     	movep.l	d0,DMAEntry.SizeL(a1)								; Write it all to the queue
(1)  223/    121A :                     	lea	DMAEntry.Command(a1),a1									; Seek to correct RAM address to store VDP DMA command
(1)  224/    121A :                     	if is68kRegister(dest)
(1)  225/    121A :                     		move.l	dest,(a1)+
(1)  226/    121A :                     	else
(1)  227/    121A :                     		move.l	#vdpComm(dest,VRAM,DMA),(a1)+					; Write VDP DMA command for destination address
(1)  228/    121A :                     	endif
(1)  229/    121A :                     	move.w	a1,(VDP_Command_Buffer_Slot).w						; Write next queue slot
(1)  230/    121A :                     .done:
(1)  231/    121A :                     	if UseVIntSafeDMA==1
(1)  232/    121A :                     		move.w	(sp)+,sr										; Restore interrupts to previous state
(1)  233/    121A :                     	endif ;UseVIntSafeDMA==1
(1)  234/    121A :                     	endm
