(1)  403/    1494 :                     ; Load a Dynamic Pattern Load Cues request into the DMA queue.
(1)  404/    1494 :                     ; ---------------------------------------------------------------------------
(1)  405/    1494 :                     ; Input:
(1)  406/    1494 :                     ;	d0.b = frame number
(1)  407/    1494 :                     ;	d4.w = starting target VRAM tile address
(1)  408/    1494 :                     ;	d6.l = pointer to uncompressed art
(1)  409/    1494 :                     ;	a2   = pointer to DPLC table
(1)  410/    1494 :                     ; ---------------------------------------------------------------------------
(1)  411/    1494 :                     
(1)  412/    1494 :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
(1)  413/    1494 :                     
(1)  414/    1494 :                     LoadDynPLC:
(1)  415/    1494 : 0240 00FF           		andi.w	#$FF,d0			; mask out anything except the input frame
(1)  416/    1498 : D040                		add.w	d0,d0			; double ID (for word-based indexing)
(1)  417/    149A : D4F2 0000           		adda.w	(a2,d0.w),a2		; find current DPLC entry
(1)  418/    149E : 7A00                		moveq	#0,d5			; clear d5
(1)  419/    14A0 : 1A1A                		move.b	(a2)+,d5		; get number of tasks in this DPLC entry
(1)  420/    14A2 : 5345                		subq.w	#1,d5			; subtract 1 from number of tasks (will be the loop count)
(1)  421/    14A4 : 6B00 002C           		bmi.w	.end			; if it underflowed, this is an empty entry, nothing to do
(1)  422/    14A8 :                     	.loop:
(1)  423/    14A8 : 7200                		moveq	#0,d1			; clear d1
(1)  424/    14AA : 121A                		move.b	(a2)+,d1		; get first byte of DPLC task
(1)  425/    14AC : E149                		lsl.w	#8,d1			; move it to upper byte
(1)  426/    14AE : 121A                		move.b	(a2)+,d1		; get second byte of DPLC task
(1)  427/    14B0 : 3601                		move.w	d1,d3			; copy to d3
(1)  428/    14B2 : E04B                		lsr.w	#8,d3			; shift upper byte to lower byte
(1)  429/    14B4 : 0243 00F0           		andi.w	#$F0,d3			; only look at upper nybble
(1)  430/    14B8 : 0643 0010           		addi.w	#$10,d3			; add 1 to that nybble
(1)  431/    14BC : 0241 0FFF           		andi.w	#$FFF,d1		; mask out that nybble in the other part
(1)  432/    14C0 : EB89                		lsl.l	#5,d1			; multiply by 32
(1)  433/    14C2 : D286                		add.l	d6,d1			; add art location
(1)  434/    14C4 : 3404                		move.w	d4,d2			; set target VRAM location
(1)  435/    14C6 : D843                		add.w	d3,d4			; advance VRAM pointer
(1)  436/    14C8 : D843                		add.w	d3,d4			; (twice, for word-based tiles)
(1)  437/    14CA : 6100 FD4E           		bsr.w	QueueDMATransfer	; load DMA request into queue (also known as "DMA_68KtoVRAM")
(1)  438/    14CE : 51CD FFD8           		dbf	d5,.loop		; repeat for number of entries
(1)  439/    14D2 :                     	.end:
(1)  440/    14D2 : 4E75                		rts				; return
