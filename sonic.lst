(2)   15/   90A66 :                     
(2)   16/   90A66 : =$1                  SMPS2ASMVer	= 1
(2)   17/   90A66 :                     
(2)   18/   90A66 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)   19/   90A66 : =$C                  psgdelta	EQU 12
(2)   20/   90A66 :                     ; ---------------------------------------------------------------------------
(2)   21/   90A66 :                     ; Standard Octave Pitch Equates
(2)   22/   90A66 :                     	enumconf	$C
(2)   23/   90A66 : =$88..$B8            	enum		smpsPitch10lo=$88,smpsPitch09lo,smpsPitch08lo,smpsPitch07lo,smpsPitch06lo
(2)   24/   90A66 : =$C4..$F4            	nextenum	smpsPitch05lo,smpsPitch04lo,smpsPitch03lo,smpsPitch02lo,smpsPitch01lo
(2)   25/   90A66 : =$0..$30             	enum		smpsPitch00=$00,smpsPitch01hi,smpsPitch02hi,smpsPitch03hi,smpsPitch04hi
(2)   26/   90A66 : =$3C..$6C            	nextenum	smpsPitch05hi,smpsPitch06hi,smpsPitch07hi,smpsPitch08hi,smpsPitch09hi
(2)   27/   90A66 : =$78                 	nextenum	smpsPitch10hi
(2)   28/   90A66 :                     	enumconf	1
(2)   29/   90A66 :                     ; ---------------------------------------------------------------------------
(2)   30/   90A66 :                     ; Note Equates
(2)   31/   90A66 : =$80                 	enum		nRst=$80
(2)   32/   90A66 : =$81..$86            	nextenum	nC0,nCs0,nDb0=nCs0,nD0,nDs0,nEb0=nDs0,nE0,nFb0=nE0,nEs0,nF0=nEs0
(2)   33/   90A66 : =$87..$8D            	nextenum	nFs0,nGb0=nFs0,nG0,nGs0,nAb0=nGs0,nA0,nAs0,nBb0=nAs0,nB0,nCb1=nB0,nBs0
(2)   34/   90A66 : =$8D..$92            	nextenum	nC1=nBs0,nCs1,nDb1=nCs1,nD1,nDs1,nEb1=nDs1,nE1,nFb1=nE1,nEs1,nF1=nEs1
(2)   35/   90A66 : =$93..$99            	nextenum	nFs1,nGb1=nFs1,nG1,nGs1,nAb1=nGs1,nA1,nAs1,nBb1=nAs1,nB1,nCb2=nB1,nBs1
(2)   36/   90A66 : =$99..$9E            	nextenum	nC2=nBs1,nCs2,nDb2=nCs2,nD2,nDs2,nEb2=nDs2,nE2,nFb2=nE2,nEs2,nF2=nEs2
(2)   37/   90A66 : =$9F..$A5            	nextenum	nFs2,nGb2=nFs2,nG2,nGs2,nAb2=nGs2,nA2,nAs2,nBb2=nAs2,nB2,nCb3=nB2,nBs2
(2)   38/   90A66 : =$A5..$AA            	nextenum	nC3=nBs2,nCs3,nDb3=nCs3,nD3,nDs3,nEb3=nDs3,nE3,nFb3=nE3,nEs3,nF3=nEs3
(2)   39/   90A66 : =$AB..$B1            	nextenum	nFs3,nGb3=nFs3,nG3,nGs3,nAb3=nGs3,nA3,nAs3,nBb3=nAs3,nB3,nCb4=nB3,nBs3
(2)   40/   90A66 : =$B1..$B6            	nextenum	nC4=nBs3,nCs4,nDb4=nCs4,nD4,nDs4,nEb4=nDs4,nE4,nFb4=nE4,nEs4,nF4=nEs4
(2)   41/   90A66 : =$B7..$BD            	nextenum	nFs4,nGb4=nFs4,nG4,nGs4,nAb4=nGs4,nA4,nAs4,nBb4=nAs4,nB4,nCb5=nB4,nBs4
(2)   42/   90A66 : =$BD..$C2            	nextenum	nC5=nBs4,nCs5,nDb5=nCs5,nD5,nDs5,nEb5=nDs5,nE5,nFb5=nE5,nEs5,nF5=nEs5
(2)   43/   90A66 : =$C3..$C9            	nextenum	nFs5,nGb5=nFs5,nG5,nGs5,nAb5=nGs5,nA5,nAs5,nBb5=nAs5,nB5,nCb6=nB5,nBs5
(2)   44/   90A66 : =$C9..$CE            	nextenum	nC6=nBs5,nCs6,nDb6=nCs6,nD6,nDs6,nEb6=nDs6,nE6,nFb6=nE6,nEs6,nF6=nEs6
(2)   45/   90A66 : =$CF..$D5            	nextenum	nFs6,nGb6=nFs6,nG6,nGs6,nAb6=nGs6,nA6,nAs6,nBb6=nAs6,nB6,nCb7=nB6,nBs6
(2)   46/   90A66 : =$D5..$DA            	nextenum	nC7=nBs6,nCs7,nDb7=nCs7,nD7,nDs7,nEb7=nDs7,nE7,nFb7=nE7,nEs7,nF7=nEs7
(2)   47/   90A66 : =$DB..$DF            	nextenum	nFs7,nGb7=nFs7,nG7,nGs7,nAb7=nGs7,nA7,nAs7,nBb7=nAs7
(2)   48/   90A66 :                     ; SMPS2ASM uses nMaxPSG for songs from S1/S2 drivers.
(2)   49/   90A66 :                     ; nMaxPSG1 and nMaxPSG2 are used only for songs from S3/S&K/S3D drivers.
(2)   50/   90A66 :                     ; The use of psgdelta is intended to undo the effects of PSGPitchConvert
(2)   51/   90A66 :                     ; and ensure that the ending note is indeed the maximum PSG frequency.
(2)   53/   90A66 : =$C6                 nMaxPSG				EQU nA5
(2)   54/   90A66 : =$D2                 nMaxPSG1			EQU nA5+psgdelta
(2)   55/   90A66 : =$D2                 nMaxPSG2			EQU nA5+psgdelta
(2)   61/   90A66 :                     ; ---------------------------------------------------------------------------
(2)   62/   90A66 :                     ; PSG volume envelope equates
(2)   65/   90A66 : =$1..$6              			enum		fTone_01=$01,fTone_02,fTone_03,fTone_04,fTone_05,fTone_06
(2)   66/   90A66 : =$7..$9              			nextenum	fTone_07,fTone_08,fTone_09
(2)   86/   90A66 :                     ; ---------------------------------------------------------------------------
(2)   87/   90A66 :                     ; DAC Equates
(2)   90/   90A66 : =$81..$83            			enum		dKick=$81,dSnare,dTimpani
(2)   91/   90A66 : =$88..$8B            			enum		dHiTimpani=$88,dMidTimpani,dLowTimpani,dVLowTimpani
(2)  169/   90A66 :                     ; ---------------------------------------------------------------------------
(2)  170/   90A66 :                     ; Channel IDs for SFX
(2)  171/   90A66 : =$80                 cPSG1				EQU $80
(2)  172/   90A66 : =$A0                 cPSG2				EQU $A0
(2)  173/   90A66 : =$C0                 cPSG3				EQU $C0
(2)  174/   90A66 : =$E0                 cNoise				EQU $E0	; Not for use in S3/S&K/S3D
(2)  175/   90A66 : =$2                  cFM3				EQU $02
(2)  176/   90A66 : =$4                  cFM4				EQU $04
(2)  177/   90A66 : =$5                  cFM5				EQU $05
(2)  178/   90A66 : =$6                  cFM6				EQU $06	; Only in S3/S&K/S3D, overrides DAC
(2)  179/   90A66 :                     ; ---------------------------------------------------------------------------
(2)  180/   90A66 :                     ; Conversion macros and functions
(2)  181/   90A66 :                     
(2)  182/   90A66 :                     conv0To256  function n,((n==0)<<8)|n
(2)  183/   90A66 :                     s2TempotoS1 function n,(((768-n)>>1)/(256-n))&$FF
(2)  184/   90A66 :                     s2TempotoS3 function n,($100-((n==0)|n))&$FF
(2)  185/   90A66 :                     s1TempotoS2 function n,((((conv0To256(n)-1)<<8)+(conv0To256(n)>>1))/conv0To256(n))&$FF
(2)  186/   90A66 :                     s1TempotoS3 function n,s2TempotoS3(s1TempotoS2(n))
(2)  187/   90A66 :                     s3TempotoS1 function n,s2TempotoS1(s2TempotoS3(n))
(2)  188/   90A66 :                     s3TempotoS2 function n,s2TempotoS3(n)
(2)  189/   90A66 :                     
(2)  190/   90A66 :                     convertMainTempoMod macro mod
(2)  191/   90A66 :                     	if ((SourceDriver>=3)&&(SonicDriverVer>=3))||(SonicDriverVer==SourceDriver)
(2)  192/   90A66 :                     		dc.b	mod
(2)  193/   90A66 :                     	elseif SourceDriver==1
(2)  194/   90A66 :                     		if mod==1
(2)  195/   90A66 :                     			fatal "Invalid main tempo of 1 in song from Sonic 1"
(2)  196/   90A66 :                     		endif
(2)  197/   90A66 :                     		if SonicDriverVer==2
(2)  198/   90A66 :                     			dc.b	s1TempotoS2(mod)
(2)  199/   90A66 :                     		else;if SonicDriverVer>=3
(2)  200/   90A66 :                     			dc.b	s1TempotoS3(mod)
(2)  201/   90A66 :                     		endif
(2)  202/   90A66 :                     	elseif SourceDriver==2
(2)  203/   90A66 :                     		if mod==0
(2)  204/   90A66 :                     			fatal "Invalid main tempo of 0 in song from Sonic 2"
(2)  205/   90A66 :                     		endif
(2)  206/   90A66 :                     		if SonicDriverVer==1
(2)  207/   90A66 :                     			dc.b	s2TempotoS1(mod)
(2)  208/   90A66 :                     		else;if SonicDriverVer>=3
(2)  209/   90A66 :                     			dc.b	s2TempotoS3(mod)
(2)  210/   90A66 :                     		endif
(2)  211/   90A66 :                     	else;if SourceDriver>=3
(2)  212/   90A66 :                     		if mod==0
(2)  213/   90A66 :                     			message "Performing approximate conversion of Sonic 3 main tempo modifier of 0"
(2)  214/   90A66 :                     		endif
(2)  215/   90A66 :                     		if SonicDriverVer==1
(2)  216/   90A66 :                     			dc.b	s3TempotoS1(mod)
(2)  217/   90A66 :                     		else;if SonicDriverVer==2
(2)  218/   90A66 :                     			dc.b	s3TempotoS2(mod)
(2)  219/   90A66 :                     		endif
(2)  220/   90A66 :                     	endif
(2)  221/   90A66 :                     	endm
(2)  222/   90A66 :                     
(2)  223/   90A66 :                     ; PSG conversion to S3/S&K/S3D drivers require a tone shift of 12 semi-tones.
(2)  224/   90A66 :                     PSGPitchConvert macro pitch
(2)  225/   90A66 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  226/   90A66 :                     		dc.b	(pitch+psgdelta)&$FF
(2)  227/   90A66 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  228/   90A66 :                     		dc.b	(pitch-psgdelta)&$FF
(2)  229/   90A66 :                     	else
(2)  230/   90A66 :                     		dc.b	pitch
(2)  231/   90A66 :                     	endif
(2)  232/   90A66 :                     	endm
(2)  233/   90A66 :                     
(2)  234/   90A66 :                     CheckedChannelPointer macro loc
(2)  235/   90A66 :                     	if SonicDriverVer<>1
(2)  236/   90A66 :                     		dc.w	z80_ptr(loc)
(2)  237/   90A66 :                     	else
(2)  238/   90A66 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  239/   90A66 :                     			fatal "Tracks for Sonic 1 songs must come after the start of the song"
(2)  240/   90A66 :                     		endif
(2)  241/   90A66 :                     		dc.w	loc-songStart
(2)  242/   90A66 :                     	endif
(2)  243/   90A66 :                     	endm
(2)  244/   90A66 :                     ; ---------------------------------------------------------------------------
(2)  245/   90A66 :                     ; Header Macros
(2)  246/   90A66 :                     smpsHeaderStartSong macro ver, sourcesmps2asmver
(2)  247/   90A66 :                     
(2)  248/   90A66 :                     SourceDriver set ver
(2)  249/   90A66 :                     
(2)  250/   90A66 :                     	if ("sourcesmps2asmver"<>"")
(2)  251/   90A66 :                     		set SourceSMPS2ASM,sourcesmps2asmver
(2)  252/   90A66 :                     	else
(2)  253/   90A66 :                     		set SourceSMPS2ASM,0
(2)  254/   90A66 :                     	endif
(2)  255/   90A66 :                     
(2)  256/   90A66 :                     songStart set *
(2)  257/   90A66 :                     
(2)  258/   90A66 :                     	if MOMPASS=1
(2)  259/   90A66 :                     		if SMPS2ASMVer < SourceSMPS2ASM
(2)  260/   90A66 :                     			message "Song at 0x\{songStart} was made for a newer version of SMPS2ASM (this is version \{SMPS2ASMVer}, but song wants at least version \{SourceSMPS2ASM})."
(2)  261/   90A66 :                     		endif
(2)  262/   90A66 :                     	endif
(2)  263/   90A66 :                     
(2)  264/   90A66 :                     	endm
(2)  265/   90A66 :                     
(2)  266/   90A66 :                     smpsHeaderVoiceNull macro
(2)  267/   90A66 :                     	if songStart<>*
(2)  268/   90A66 :                     		fatal "Missing smpsHeaderStartSong"
(2)  269/   90A66 :                     	endif
(2)  270/   90A66 :                     	dc.w	$0000
(2)  271/   90A66 :                     	endm
(2)  272/   90A66 :                     
(2)  273/   90A66 :                     ; Header - Set up Voice Location
(2)  274/   90A66 :                     ; Common to music and SFX
(2)  275/   90A66 :                     smpsHeaderVoice macro loc
(2)  276/   90A66 :                     	if songStart<>*
(2)  277/   90A66 :                     		fatal "Missing smpsHeaderStartSong"
(2)  278/   90A66 :                     	endif
(2)  279/   90A66 :                     	if SonicDriverVer<>1
(2)  280/   90A66 :                     		dc.w	z80_ptr(loc)
(2)  281/   90A66 :                     	else
(2)  282/   90A66 :                     		if (MOMPASS=1)&&(DEFINED(loc))
(2)  283/   90A66 :                     			fatal "Voice banks for Sonic 1 songs must come after the start of the song"
(2)  284/   90A66 :                     		endif
(2)  285/   90A66 :                     		dc.w	loc-songStart
(2)  286/   90A66 :                     	endif
(2)  287/   90A66 :                     	endm
(2)  288/   90A66 :                     
(2)  289/   90A66 :                     ; Header - Set up Voice Location as S3's Universal Voice Bank
(2)  290/   90A66 :                     ; Common to music and SFX
(2)  291/   90A66 :                     smpsHeaderVoiceUVB macro
(2)  292/   90A66 :                     	if songStart<>*
(2)  293/   90A66 :                     		fatal "Missing smpsHeaderStartSong"
(2)  294/   90A66 :                     	endif
(2)  295/   90A66 :                     	if SonicDriverVer>=5
(2)  296/   90A66 :                     		dc.w	z80_ptr(z80_UniVoiceBank)
(2)  297/   90A66 :                     	elseif SonicDriverVer>=3
(2)  298/   90A66 :                     		dc.w	little_endian(z80_UniVoiceBank)
(2)  299/   90A66 :                     	else
(2)  300/   90A66 :                     		fatal "Universal Voice Bank does not exist in Sonic 1 or Sonic 2 drivers"
(2)  301/   90A66 :                     	endif
(2)  302/   90A66 :                     	endm
(2)  303/   90A66 :                     
(2)  304/   90A66 :                     ; Header macros for music (not for SFX)
(2)  305/   90A66 :                     ; Header - Set up Channel Usage
(2)  306/   90A66 :                     smpsHeaderChan macro fm,psg
(2)  307/   90A66 :                     	dc.b	fm,psg
(2)  308/   90A66 :                     	endm
(2)  309/   90A66 :                     
(2)  310/   90A66 :                     ; Header - Set up Tempo
(2)  311/   90A66 :                     smpsHeaderTempo macro div,mod
(2)  312/   90A66 :                     	dc.b	div
(2)  313/   90A66 :                     	convertMainTempoMod mod
(2)  314/   90A66 :                     	endm
(2)  315/   90A66 :                     
(2)  316/   90A66 :                     ; Header - Set up DAC Channel
(2)  317/   90A66 :                     smpsHeaderDAC macro loc,pitch,vol
(2)  318/   90A66 :                     	CheckedChannelPointer loc
(2)  319/   90A66 :                     	if ("pitch"<>"")
(2)  320/   90A66 :                     		dc.b	pitch
(2)  321/   90A66 :                     		if ("vol"<>"")
(2)  322/   90A66 :                     			dc.b	vol
(2)  323/   90A66 :                     		else
(2)  324/   90A66 :                     			dc.b	$00
(2)  325/   90A66 :                     		endif
(2)  326/   90A66 :                     	else
(2)  327/   90A66 :                     		dc.w	$00
(2)  328/   90A66 :                     	endif
(2)  329/   90A66 :                     	endm
(2)  330/   90A66 :                     
(2)  331/   90A66 :                     ; Header - Set up FM Channel
(2)  332/   90A66 :                     smpsHeaderFM macro loc,pitch,vol
(2)  333/   90A66 :                     	CheckedChannelPointer loc
(2)  334/   90A66 :                     	dc.b	pitch,vol
(2)  335/   90A66 :                     	endm
(2)  336/   90A66 :                     
(2)  337/   90A66 :                     ; Header - Set up PSG Channel
(2)  338/   90A66 :                     smpsHeaderPSG macro loc,pitch,vol,mod,voice
(2)  339/   90A66 :                     	CheckedChannelPointer loc
(2)  340/   90A66 :                     	PSGPitchConvert pitch
(2)  341/   90A66 :                     	dc.b	vol
(2)  342/   90A66 :                     	; Frequency envelope
(2)  343/   90A66 :                     	if (SonicDriverVer>=3) && (SourceDriver<3)
(2)  344/   90A66 :                     		; In SMPS 68k Type 1, this byte is skipped and can contain garbage.
(2)  345/   90A66 :                     		; Sonic 2's Oil Ocean Zone and Ending themes set this byte to a non-zero value which
(2)  346/   90A66 :                     		; other drivers may try to process as valid data, so manually force it to 0 here.
(2)  347/   90A66 :                     		dc.b	0
(2)  348/   90A66 :                     	else
(2)  349/   90A66 :                     		if (MOMPASS==1) && (SonicDriverVer<3) && (SourceDriver>=3) && (mod<>0)
(2)  350/   90A66 :                     			message "This track header specifies a frequency envelope, but this driver does not support them."			
(2)  351/   90A66 :                     		endif
(2)  352/   90A66 :                     		dc.b	mod
(2)  353/   90A66 :                     	endif
(2)  354/   90A66 :                     	; Volume envelope
(2)  355/   90A66 :                     	dc.b	voice
(2)  356/   90A66 :                     	endm
(2)  357/   90A66 :                     
(2)  358/   90A66 :                     ; Header macros for SFX (not for music)
(2)  359/   90A66 :                     ; Header - Set up Tempo
(2)  360/   90A66 :                     smpsHeaderTempoSFX macro div
(2)  361/   90A66 :                     	dc.b	div
(2)  362/   90A66 :                     	endm
(2)  363/   90A66 :                     
(2)  364/   90A66 :                     ; Header - Set up Channel Usage
(2)  365/   90A66 :                     smpsHeaderChanSFX macro chan
(2)  366/   90A66 :                     	dc.b	chan
(2)  367/   90A66 :                     	endm
(2)  368/   90A66 :                     
(2)  369/   90A66 :                     ; Header - Set up FM Channel
(2)  370/   90A66 :                     smpsHeaderSFXChannel macro chanid,loc,pitch,vol
(2)  371/   90A66 :                     	if (SonicDriverVer>=3)&&(chanid==cNoise)
(2)  372/   90A66 :                     		fatal "Using channel ID of cNoise ($E0) in Sonic 3 driver is dangerous. Fix the song so that it turns into a noise channel instead."
(2)  373/   90A66 :                     	elseif (SonicDriverVer<3)&&(chanid==cFM6)
(2)  374/   90A66 :                     		fatal "Using channel ID of FM6 ($06) in Sonic 1 or Sonic 2 drivers is unsupported. Change it to another channel."
(2)  375/   90A66 :                     	endif
(2)  376/   90A66 :                     	dc.b	$80,chanid
(2)  377/   90A66 :                     	CheckedChannelPointer loc
(2)  378/   90A66 :                     	if (chanid&$80)<>0
(2)  379/   90A66 :                     		PSGPitchConvert pitch
(2)  380/   90A66 :                     	else
(2)  381/   90A66 :                     		dc.b	pitch
(2)  382/   90A66 :                     	endif
(2)  383/   90A66 :                     	dc.b	vol
(2)  384/   90A66 :                     	endm
(2)  385/   90A66 :                     ; ---------------------------------------------------------------------------
(2)  386/   90A66 :                     ; Co-ord Flag Macros and Equates
(2)  387/   90A66 :                     ; E0xx - Panning, AMS, FMS
(2)  388/   90A66 :                     smpsPan macro direction,amsfms
(2)  389/   90A66 :                     panNone set $00
(2)  390/   90A66 :                     panRight set $40
(2)  391/   90A66 :                     panLeft set $80
(2)  392/   90A66 :                     panCentre set $C0
(2)  393/   90A66 :                     panCenter set $C0 ; silly Americans :U
(2)  394/   90A66 :                     	dc.b $E0,direction+amsfms
(2)  395/   90A66 :                     	endm
(2)  396/   90A66 :                     
(2)  397/   90A66 :                     ; E1xx - Set channel detune to val
(2)  398/   90A66 :                     smpsDetune macro val
(2)  399/   90A66 :                     	dc.b	$E1,val
(2)  400/   90A66 :                     	endm
(2)  401/   90A66 :                     
(2)  402/   90A66 :                     ; E2xx - Used for setting a variable which can be read by the game, for synchonisation. Ristar does this.
(2)  403/   90A66 :                     smpsNop macro val
(2)  404/   90A66 :                     	if (SonicDriverVer>=3) && ((val==$FF) || (val==$29))
(2)  405/   90A66 :                     		warning "Values $FF and $29 are reserved in S3K's driver; use a different value or remove this command."
(2)  406/   90A66 :                     	endif
(2)  407/   90A66 :                     	dc.b	$E2,val
(2)  408/   90A66 :                     	endm
(2)  409/   90A66 :                     
(2)  410/   90A66 :                     ; Return (used after smpsCall)
(2)  411/   90A66 :                     smpsReturn macro val
(2)  412/   90A66 :                     	if SonicDriverVer>=3
(2)  413/   90A66 :                     		dc.b	$F9
(2)  414/   90A66 :                     	else
(2)  415/   90A66 :                     		dc.b	$E3
(2)  416/   90A66 :                     	endif
(2)  417/   90A66 :                     	endm
(2)  418/   90A66 :                     
(2)  419/   90A66 :                     ; Fade in previous song (ie. 1-Up)
(2)  420/   90A66 :                     smpsFade macro val
(2)  421/   90A66 :                     	if SonicDriverVer>=3
(2)  422/   90A66 :                     		dc.b	$E2
(2)  423/   90A66 :                     		if ("val"<>"")
(2)  424/   90A66 :                     			dc.b	val
(2)  425/   90A66 :                     		else
(2)  426/   90A66 :                     			dc.b	$FF
(2)  427/   90A66 :                     		endif
(2)  428/   90A66 :                     		if SourceDriver<3
(2)  429/   90A66 :                     			smpsStop
(2)  430/   90A66 :                     		endif
(2)  431/   90A66 :                     	elseif (SourceDriver>=3) && ("val"<>"") && ("val"<>"$FF")
(2)  432/   90A66 :                     		; This is actually a communication byte, not a fade.
(2)  433/   90A66 :                     		smpsNop	val
(2)  434/   90A66 :                     	else
(2)  435/   90A66 :                     		dc.b	$E4
(2)  436/   90A66 :                     	endif
(2)  437/   90A66 :                     	endm
(2)  438/   90A66 :                     
(2)  439/   90A66 :                     ; E5xx - Set channel tempo divider to xx
(2)  440/   90A66 :                     smpsChanTempoDiv macro val
(2)  441/   90A66 :                     	if SonicDriverVer>=5
(2)  442/   90A66 :                     		; New flag unique to Flamewing's modified S&K driver
(2)  443/   90A66 :                     		dc.b	$FF,$08,val
(2)  444/   90A66 :                     	elseif SonicDriverVer==3
(2)  445/   90A66 :                     		fatal "Coord. Flag to set tempo divider of a single channel does not exist in S3 driver. Use Flamewing's modified S&K sound driver instead."
(2)  446/   90A66 :                     	else
(2)  447/   90A66 :                     		dc.b	$E5,val
(2)  448/   90A66 :                     	endif
(2)  449/   90A66 :                     	endm
(2)  450/   90A66 :                     
(2)  451/   90A66 :                     ; E6xx - Alter Volume by xx
(2)  452/   90A66 :                     smpsAlterVol macro val
(2)  453/   90A66 :                     	dc.b	$E6,val
(2)  454/   90A66 :                     	endm
(2)  455/   90A66 :                     
(2)  456/   90A66 :                     ; E7 - Prevent attack of next note
(2)  457/   90A66 : =$E7                 smpsNoAttack	EQU $E7
(2)  458/   90A66 :                     
(2)  459/   90A66 :                     ; E8xx - Set note fill to xx
(2)  460/   90A66 :                     smpsNoteFill macro val
(2)  461/   90A66 :                     	if (SonicDriverVer>=5)&&(SourceDriver<3)
(2)  462/   90A66 :                     		; Unique to Flamewing's modified driver
(2)  463/   90A66 :                     		dc.b	$FF,$0A,val
(2)  464/   90A66 :                     	else
(2)  465/   90A66 :                     		if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  466/   90A66 :                     			message "Note fill will not work as intended unless you divide the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  467/   90A66 :                     		elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  468/   90A66 :                     			message "Note fill will not work as intended unless you multiply the fill value by the tempo divider or complain to Flamewing to add an appropriate coordination flag for it."
(2)  469/   90A66 :                     		endif
(2)  470/   90A66 :                     		dc.b	$E8,val
(2)  471/   90A66 :                     	endif
(2)  472/   90A66 :                     	endm
(2)  473/   90A66 :                     
(2)  474/   90A66 :                     ; Add xx to channel pitch
(2)  475/   90A66 :                     smpsChangeTransposition macro val
(2)  476/   90A66 :                     	if SonicDriverVer>=3
(2)  477/   90A66 :                     		dc.b	$FB,val
(2)  478/   90A66 :                     	else
(2)  479/   90A66 :                     		dc.b	$E9,val
(2)  480/   90A66 :                     	endif
(2)  481/   90A66 :                     	endm
(2)  482/   90A66 :                     
(2)  483/   90A66 :                     ; Set music tempo modifier to xx
(2)  484/   90A66 :                     smpsSetTempoMod macro mod
(2)  485/   90A66 :                     	if SonicDriverVer>=3
(2)  486/   90A66 :                     		dc.b	$FF,$00
(2)  487/   90A66 :                     	else
(2)  488/   90A66 :                     		dc.b	$EA
(2)  489/   90A66 :                     	endif
(2)  490/   90A66 :                     	convertMainTempoMod mod
(2)  491/   90A66 :                     	endm
(2)  492/   90A66 :                     
(2)  493/   90A66 :                     ; Set music tempo divider to xx
(2)  494/   90A66 :                     smpsSetTempoDiv macro val
(2)  495/   90A66 :                     	if SonicDriverVer>=3
(2)  496/   90A66 :                     		dc.b	$FF,$04,val
(2)  497/   90A66 :                     	else
(2)  498/   90A66 :                     		dc.b	$EB,val
(2)  499/   90A66 :                     	endif
(2)  500/   90A66 :                     	endm
(2)  501/   90A66 :                     
(2)  502/   90A66 :                     ; ECxx - Set Volume to xx
(2)  503/   90A66 :                     smpsSetVol macro val
(2)  504/   90A66 :                     	if SonicDriverVer>=3
(2)  505/   90A66 :                     		dc.b	$E4,val
(2)  506/   90A66 :                     	else
(2)  507/   90A66 :                     		fatal "Coord. Flag to set volume (instead of volume attenuation) does not exist in S1 or S2 drivers. Complain to Flamewing to add it."
(2)  508/   90A66 :                     	endif
(2)  509/   90A66 :                     	endm
(2)  510/   90A66 :                     
(2)  511/   90A66 :                     ; Works on all drivers
(2)  512/   90A66 :                     smpsPSGAlterVol macro vol
(2)  513/   90A66 :                     	dc.b	$EC,vol
(2)  514/   90A66 :                     	endm
(2)  515/   90A66 :                     
(2)  516/   90A66 :                     smpsPSGAlterVolS2 macro vol
(2)  517/   90A66 :                     	; Sonic 2's driver allows the FM command to be used on PSG channels, but others do not.
(2)  518/   90A66 :                     	if SonicDriverVer==2
(2)  519/   90A66 :                     		smpsAlterVol vol
(2)  520/   90A66 :                     	else
(2)  521/   90A66 :                     		smpsPSGAlterVol vol
(2)  522/   90A66 :                     	endif
(2)  523/   90A66 :                     	endm
(2)  524/   90A66 :                     
(2)  525/   90A66 :                     ; Clears pushing sound flag in S1
(2)  526/   90A66 :                     smpsClearPush macro
(2)  527/   90A66 :                     	if SonicDriverVer==1
(2)  528/   90A66 :                     		dc.b	$ED
(2)  529/   90A66 :                     	else
(2)  530/   90A66 :                     		fatal "Coord. Flag to clear S1 push block flag does not exist in S2 or S3 drivers. Complain to Flamewing to add it."
(2)  531/   90A66 :                     	endif
(2)  532/   90A66 :                     	endm
(2)  533/   90A66 :                     
(2)  534/   90A66 :                     ; Stops special SFX (S1 only) and restarts overridden music track
(2)  535/   90A66 :                     smpsStopSpecial macro
(2)  536/   90A66 :                     	if SonicDriverVer==1
(2)  537/   90A66 :                     		dc.b	$EE
(2)  538/   90A66 :                     	else
(2)  539/   90A66 :                     		message "Coord. Flag to stop special SFX does not exist in S2 or S3 drivers. Complain to Flamewing to add it. With adequate caution, smpsStop can do this job."
(2)  540/   90A66 :                     		smpsStop
(2)  541/   90A66 :                     	endif
(2)  542/   90A66 :                     	endm
(2)  543/   90A66 :                     
(2)  544/   90A66 :                     ; EFxx[yy] - Set Voice of FM channel to xx; xx < 0 means yy present
(2)  545/   90A66 :                     smpsFMvoice macro voice,songID
(2)  546/   90A66 :                     	if (SonicDriverVer>=3)&&("songID"<>"")
(2)  547/   90A66 :                     		dc.b	$EF,voice|$80,songID+$81
(2)  548/   90A66 :                     	else
(2)  549/   90A66 :                     		dc.b	$EF,voice
(2)  550/   90A66 :                     	endif
(2)  551/   90A66 :                     	endm
(2)  552/   90A66 :                     
(2)  553/   90A66 :                     ; F0wwxxyyzz - Modulation - ww: wait time - xx: modulation speed - yy: change per step - zz: number of steps
(2)  554/   90A66 :                     smpsModSet macro wait,speed,change,step
(2)  555/   90A66 :                     	dc.b	$F0
(2)  556/   90A66 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  557/   90A66 :                     		dc.b	wait+1,speed,change,((step+1) * speed) & $FF
(2)  558/   90A66 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)
(2)  559/   90A66 :                     		dc.b	wait-1,speed,change,conv0To256(step)/conv0To256(speed)-1
(2)  560/   90A66 :                     	else
(2)  561/   90A66 :                     		dc.b	wait,speed,change,step
(2)  562/   90A66 :                     	endif
(2)  563/   90A66 :                     	;dc.b	speed,change,step
(2)  564/   90A66 :                     	endm
(2)  565/   90A66 :                     
(2)  566/   90A66 :                     ; Turn on Modulation
(2)  567/   90A66 :                     smpsModOn macro type
(2)  568/   90A66 :                     	if SonicDriverVer>=3
(2)  569/   90A66 :                     		if "type"<>""
(2)  570/   90A66 :                     			dc.b	$F4,type
(2)  571/   90A66 :                     		else
(2)  572/   90A66 :                     			dc.b	$F4,$80
(2)  573/   90A66 :                     		endif
(2)  574/   90A66 :                     	else
(2)  575/   90A66 :                     		dc.b	$F1
(2)  576/   90A66 :                     	endif
(2)  577/   90A66 :                     	endm
(2)  578/   90A66 :                     
(2)  579/   90A66 :                     ; F2 - End of channel
(2)  580/   90A66 :                     smpsStop macro
(2)  581/   90A66 :                     	dc.b	$F2
(2)  582/   90A66 :                     	endm
(2)  583/   90A66 :                     
(2)  584/   90A66 :                     ; F3xx - PSG waveform to xx
(2)  585/   90A66 :                     smpsPSGform macro form
(2)  586/   90A66 :                     	dc.b	$F3,form
(2)  587/   90A66 :                     	endm
(2)  588/   90A66 :                     
(2)  589/   90A66 :                     ; Turn off Modulation
(2)  590/   90A66 :                     smpsModOff macro
(2)  591/   90A66 :                     	if SonicDriverVer>=3
(2)  592/   90A66 :                     		dc.b	$FA
(2)  593/   90A66 :                     	else
(2)  594/   90A66 :                     		dc.b	$F4
(2)  595/   90A66 :                     	endif
(2)  596/   90A66 :                     	endm
(2)  597/   90A66 :                     
(2)  598/   90A66 :                     ; F5xx - PSG voice to xx
(2)  599/   90A66 :                     smpsPSGvoice macro voice
(2)  600/   90A66 :                     	dc.b	$F5,voice
(2)  601/   90A66 :                     	endm
(2)  602/   90A66 :                     
(2)  603/   90A66 :                     ; F6xxxx - Jump to xxxx
(2)  604/   90A66 :                     smpsJump macro loc
(2)  605/   90A66 :                     	dc.b	$F6
(2)  606/   90A66 :                     	if SonicDriverVer<>1
(2)  607/   90A66 :                     		dc.w	z80_ptr(loc)
(2)  608/   90A66 :                     	else
(2)  609/   90A66 :                     		dc.w	loc-*-1
(2)  610/   90A66 :                     	endif
(2)  611/   90A66 :                     	endm
(2)  612/   90A66 :                     
(2)  613/   90A66 :                     ; F7xxyyzzzz - Loop back to zzzz yy times, xx being the loop index for loop recursion fixing
(2)  614/   90A66 :                     smpsLoop macro index,loops,loc
(2)  615/   90A66 :                     	dc.b	$F7
(2)  616/   90A66 :                     	dc.b	index,loops
(2)  617/   90A66 :                     	if SonicDriverVer<>1
(2)  618/   90A66 :                     		dc.w	z80_ptr(loc)
(2)  619/   90A66 :                     	else
(2)  620/   90A66 :                     		dc.w	loc-*-1
(2)  621/   90A66 :                     	endif
(2)  622/   90A66 :                     	endm
(2)  623/   90A66 :                     
(2)  624/   90A66 :                     ; F8xxxx - Call pattern at xxxx, saving return point
(2)  625/   90A66 :                     smpsCall macro loc
(2)  626/   90A66 :                     	dc.b	$F8
(2)  627/   90A66 :                     	if SonicDriverVer<>1
(2)  628/   90A66 :                     		dc.w	z80_ptr(loc)
(2)  629/   90A66 :                     	else
(2)  630/   90A66 :                     		dc.w	loc-*-1
(2)  631/   90A66 :                     	endif
(2)  632/   90A66 :                     	endm
(2)  633/   90A66 :                     ; ---------------------------------------------------------------------------
(2)  634/   90A66 :                     ; Alter Volume
(2)  635/   90A66 :                     smpsFMAlterVol macro val1,val2
(2)  636/   90A66 :                     	if ("val2"<>"")
(2)  637/   90A66 :                     		; S3K's nerfed 'PSG & FM volume' command with broken PSG support.
(2)  638/   90A66 :                     		; The first value is completely unused, while the second is for FM tracks.
(2)  639/   90A66 :                     		if (SonicDriverVer>=3)
(2)  640/   90A66 :                     			dc.b	$E5,val1,val2
(2)  641/   90A66 :                     		else
(2)  642/   90A66 :                     			dc.b	$E6,val2
(2)  643/   90A66 :                     		endif
(2)  644/   90A66 :                     	else
(2)  645/   90A66 :                     		; Normal, sane command.
(2)  646/   90A66 :                     		dc.b	$E6,val1
(2)  647/   90A66 :                     	endif
(2)  648/   90A66 :                     	endm
(2)  649/   90A66 :                     
(2)  650/   90A66 :                     ; S3/S&K/S3D-only coordination flags
(2)  755/   90A66 :                     ; ---------------------------------------------------------------------------
