(1) 1809/   8EC00 :                     ; ===========================================================================
(1) 1810/   8EC00 :                     ; ---------------------------------------------------------------------------
(1) 1811/   8EC00 :                     ; FM Note Values: b-0 to a#8
(1) 1812/   8EC00 :                     ;
(1) 1813/   8EC00 :                     ; Each row is an octave, starting with B and ending with A-sharp/B-flat.
(1) 1814/   8EC00 :                     ; Notably, this differs from the PSG frequency table, which starts with C and
(1) 1815/   8EC00 :                     ; ends with B. This is caused by 'FMSetFreq' subtracting $80 from the note
(1) 1816/   8EC00 :                     ; instead of $81, meaning that the first frequency in the table ironically
(1) 1817/   8EC00 :                     ; corresponds to the 'rest' note. The only way to use this frequency in a
(1) 1818/   8EC00 :                     ; real note is to transpose the channel to a lower semitone.
(1) 1819/   8EC00 :                     ;
(1) 1820/   8EC00 :                     ; Rather than use a complete lookup table, other SMPS drivers such as
(1) 1821/   8EC00 :                     ; Sonic 3's compute the octave, and only store a single octave's worth of
(1) 1822/   8EC00 :                     ; notes in the table.
(1) 1823/   8EC00 :                     ;
(1) 1824/   8EC00 :                     ; Invalid transposition values will cause this table to be overflowed,
(1) 1825/   8EC00 :                     ; resulting in garbage data being used as frequency values. In drivers that
(1) 1826/   8EC00 :                     ; compute the octave instead, invalid transposition values merely cause the
(1) 1827/   8EC00 :                     ; notes to wrap-around (the note below the lowest note will be the highest
(1) 1828/   8EC00 :                     ; note). It's important to keep this in mind when porting buggy songs.
(1) 1829/   8EC00 :                     ; ---------------------------------------------------------------------------
(1) 1830/   8EC00 :                     MakeFMFrequency function frequency,roundFloatToInteger(frequency*1024*1024*2/FM_Sample_Rate)
(1) 1831/   8EC00 :                     MakeFMFrequenciesOctave macro octave
(1) 1832/   8EC00 :                     		; Frequencies for the base octave. The first frequency is B, the last frequency is B-flat.
(1) 1833/   8EC00 :                     		irp op, 15.39, 16.35, 17.34, 18.36, 19.45, 20.64, 21.84, 23.13, 24.51, 25.98, 27.53, 29.15
(1) 1834/   8EC00 :                     			dc.w MakeFMFrequency(op)+octave*$800
(1) 1835/   8EC00 :                     		endm
(1) 1836/   8EC00 :                     	endm
(1) 1837/   8EC00 :                     
