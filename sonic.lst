    8702/   8D754 :                     		; SoundDriver starts at $71990 in all revisions, which amounts
    8703/   8D754 :                     		; to $62A bytes of padding for rev00 and $63C for rev01/rev02.
    8704/   8D754 :                     		; It appears to be placed in such a way that the sound driver
    8705/   8D754 :                     		; ends right on the $80000 mark in the ROM in all revisions.
    8706/   8D754 :                     		; From a technical standpoint, this padding serves no purpose.
