(2)  762/   90A66 :                     		smpsFMICommand $8C,$0F
(2)  763/   90A66 :                     	else
(2)  764/   90A66 :                     		dc.b	$F9
(2)  765/   90A66 :                     	endif
(2)  766/   90A66 :                     	endm
