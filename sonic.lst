(1)    1/   15C16 :                     ; ---------------------------------------------------------------------------
(1)    2/   15C16 :                     ; Subroutine to horizontally pan the camera view ahead of the player
(1)    3/   15C16 :                     ; (Ported from the US version of Sonic CD's "R11A__.MMD" by Nat The Porcupine)
(1)    4/   15C16 :                     ; ---------------------------------------------------------------------------
(1)    5/   15C16 :                     
(1)    6/   15C16 :                     ; ||||||||||||||| S U B    R O U T    I N E |||||||||||||||||||||||||||||||||||||||
(1)    7/   15C16 :                     
(1)    8/   15C16 :                     
(1)    9/   15C16 :                     Sonic_PanCamera:
(1)   10/   15C16 : 3238 F7A2                   move.w    (v_camera_pan).w,d1        ; get the current camera pan value
(1)   11/   15C1A : 3028 0014                   move.w    obInertia(a0),d0        ; get sonic's inertia
(1)   12/   15C1E : 6A02                        bpl.s    abs_inertia            ; if sonic's inertia is positive, branch ahead
(1)   13/   15C20 : 4440                        neg.w    d0                        ; otherwise, we negate it to get the absolute value
(1)   14/   15C22 :                     
(1)   15/   15C22 :                         abs_inertia:
(1)   16/   15C22 :                     
(1)   17/   15C22 :                     ; These lines were intended to prevent the Camera from panning while
(1)   18/   15C22 :                     ; going up the very first giant ramp in Palmtree Panic Zone Act 1.
(1)   19/   15C22 :                     ; However, given that no such object exists in Sonic 1, I just went
(1)   20/   15C22 :                     ; ahead and commented these out.
(1)   21/   15C22 :                     ;        btst    #1,$2C(a0)                ; is sonic going up a giant ramp in PPZ?
(1)   22/   15C22 :                     ;        beq.s    skip                    ; if not, branch
(1)   23/   15C22 :                     ;        cmpi.w    #$1B00,obX(a0)            ; is sonic's x position lower than $1B00?
(1)   24/   15C22 :                     ;        bcs.s    reset_pan                ; if so, branch
(1)   25/   15C22 :                     
(1)   26/   15C22 :                     ; These lines aren't part of the original routine; I added them myself.
(1)   27/   15C22 :                     ; If you've ported the Spin Dash, uncomment the following lines of code
(1)   28/   15C22 :                     ; to allow the camera to pan ahead while charging the Spin Dash:
(1)   29/   15C22 : 4A28 0039                   tst.b    $39(a0)                    ; is sonic charging up a spin dash?
(1)   30/   15C26 : 670A                        beq.s    skip                    ; if not, branch
(1)   31/   15C28 : 0828 0000 0022              btst    #0,obStatus(a0)            ; check the direction that sonic is facing
(1)   32/   15C2E : 660E                        bne.s    pan_right                ; if he's facing right, pan the camera to the right
(1)   33/   15C30 : 601A                        bra.s    pan_left                ; otherwise, pan the camera to the left
(1)   34/   15C32 :                     
(1)   35/   15C32 :                         skip:
(1)   36/   15C32 : 0C40 0600                   cmpi.w    #$600,d0                ; is sonic's inertia greater than $600
(1)   37/   15C36 : 6522                        bcs.s    reset_pan                ; if not, recenter the screen (if needed)
(1)   38/   15C38 : 4A68 0014                   tst.w    obInertia(a0)            ; otherwise, check the direction of inertia (by subtracting it from 0)
(1)   39/   15C3C : 6A0E                        bpl.s    pan_left                ; if the result was positive, then inertia was negative, so we pan the screen left
(1)   40/   15C3E :                     
(1)   41/   15C3E :                         pan_right:
(1)   42/   15C3E : 5441                        addq.w    #2,d1                    ; add 2 to the pan value
(1)   43/   15C40 : 0C41 00E0                   cmpi.w    #224,d1                    ; is the pan value greater than 224 pixels?
(1)   44/   15C44 : 6522                        bcs.s    update_pan                ; if not, branch
(1)   45/   15C46 : 323C 00E0                   move.w    #224,d1                    ; otherwise, cap the value at the maximum of 224 pixels
(1)   46/   15C4A : 601C                        bra.s    update_pan                ; branch
(1)   47/   15C4C :                     ; ---------------------------------------------------------------------------
(1)   48/   15C4C :                     
(1)   49/   15C4C :                         pan_left:
(1)   50/   15C4C : 5541                        subq.w    #2,d1                    ; subtract 2 from the pan value
(1)   51/   15C4E : 0C41 0060                   cmpi.w    #96,d1                    ; is the pan value less than 96 pixels?
(1)   52/   15C52 : 6414                        bcc.s    update_pan                ; if not, branch
(1)   53/   15C54 : 323C 0060                   move.w    #96,d1                    ; otherwise, cap the value at the minimum of 96 pixels
(1)   54/   15C58 : 600E                        bra.s    update_pan                ; branch
(1)   55/   15C5A :                     ; ---------------------------------------------------------------------------
(1)   56/   15C5A :                     
(1)   57/   15C5A :                         reset_pan:
(1)   58/   15C5A : 0C41 00A0                   cmpi.w    #160,d1                    ; is the pan value 160 pixels?
(1)   59/   15C5E : 6708                        beq.s    update_pan                ; if so, branch
(1)   60/   15C60 : 6404                        bcc.s    reset_left                ; otherwise, branch if it greater than 160
(1)   61/   15C62 :                          
(1)   62/   15C62 :                         reset_right:
(1)   63/   15C62 : 5441                        addq.w    #2,d1                    ; add 2 to the pan value
(1)   64/   15C64 : 6002                        bra.s    update_pan                ; branch
(1)   65/   15C66 :                     ; ---------------------------------------------------------------------------
(1)   66/   15C66 :                     
(1)   67/   15C66 :                         reset_left:
(1)   68/   15C66 : 5541                        subq.w    #2,d1                    ; subtract 2 from the pan value
(1)   69/   15C68 :                     
(1)   70/   15C68 :                         update_pan:
(1)   71/   15C68 : 31C1 F7A2                   move.w    d1,(v_camera_pan).w        ; update the camera pan value
(1)   72/   15C6C : 4E75                        rts                                ; return
(1)   73/   15C6E :                     ; End of function Sonic_PanCamera
