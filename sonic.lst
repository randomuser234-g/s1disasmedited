(2)  800/   90A66 :                     smpsVcUnusedBits macro val,d1r1,d1r2,d1r3,d1r4
(2)  801/   90A66 :                     vcUnusedBits eval val
(2)  802/   90A66 :                     	if ("d1r1"<>"")&&("d1r2"<>"")&&("d1r3"<>"")&&("d1r4"<>"")
(2)  803/   90A66 :                     		eval vcD1R1Unk,d1r1<<5
(2)  804/   90A66 :                     		eval vcD1R2Unk,d1r2<<5
(2)  805/   90A66 :                     		eval vcD1R3Unk,d1r3<<5
