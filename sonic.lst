(2)  846/   90A66 :                     
(2)  847/   90A66 :                     ; Voices - Amplitude Modulation
(2)  848/   90A66 :                     ; The original SMPS2ASM erroneously assumed the 6th and 7th bits
(2)  849/   90A66 :                     ; were the Amplitude Modulation.
(2)  850/   90A66 :                     ; According to several docs, however, it's actually the high bit.
(2)  851/   90A66 :                     smpsVcAmpMod macro op1,op2,op3,op4
(2)  852/   90A66 :                     	if SourceSMPS2ASM==0
(2)  853/   90A66 :                     		eval vcAM1,op1<<5
(2)  854/   90A66 :                     		eval vcAM2,op2<<5
(2)  855/   90A66 :                     		eval vcAM3,op3<<5
(2)  856/   90A66 :                     		eval vcAM4,op4<<5
(2)  857/   90A66 :                     	else
(2)  858/   90A66 :                     		eval vcAM1,op1<<7
(2)  859/   90A66 :                     		eval vcAM2,op2<<7
(2)  860/   90A66 :                     		eval vcAM3,op3<<7
(2)  861/   90A66 :                     		eval vcAM4,op4<<7
(2)  862/   90A66 :                     	endif
(2)  863/   90A66 :                     	endm
(2)  864/   90A66 :                     
(2)  865/   90A66 :                     ; Voices - First Decay Rate
(2)  866/   90A66 :                     smpsVcDecayRate1 macro op1,op2,op3,op4
(2)  867/   90A66 :                     	eval vcD1R1,op1
(2)  868/   90A66 :                     	eval vcD1R2,op2
(2)  869/   90A66 :                     	eval vcD1R3,op3
(2)  870/   90A66 :                     	eval vcD1R4,op4
(2)  871/   90A66 :                     	endm
(2)  872/   90A66 :                     
(2)  873/   90A66 :                     ; Voices - Second Decay Rate
(2)  874/   90A66 :                     smpsVcDecayRate2 macro op1,op2,op3,op4
(2)  875/   90A66 :                     	eval vcD2R1,op1
(2)  876/   90A66 :                     	eval vcD2R2,op2
(2)  877/   90A66 :                     	eval vcD2R3,op3
(2)  878/   90A66 :                     	eval vcD2R4,op4
(2)  879/   90A66 :                     	endm
(2)  880/   90A66 :                     
(2)  881/   90A66 :                     ; Voices - Decay Level
(2)  882/   90A66 :                     smpsVcDecayLevel macro op1,op2,op3,op4
(2)  883/   90A66 :                     	eval vcDL1,op1
(2)  884/   90A66 :                     	eval vcDL2,op2
(2)  885/   90A66 :                     	eval vcDL3,op3
(2)  886/   90A66 :                     	eval vcDL4,op4
(2)  887/   90A66 :                     	endm
(2)  888/   90A66 :                     
(2)  889/   90A66 :                     ; Voices - Release Rate
(2)  890/   90A66 :                     smpsVcReleaseRate macro op1,op2,op3,op4
(2)  891/   90A66 :                     	eval vcRR1,op1
(2)  892/   90A66 :                     	eval vcRR2,op2
(2)  893/   90A66 :                     	eval vcRR3,op3
(2)  894/   90A66 :                     	eval vcRR4,op4
(2)  895/   90A66 :                     	endm
(2)  896/   90A66 :                     
(2)  897/   90A66 :                     smpsNotZ80 function cpu,(cpu<>128)&&(cpu<>32988)
(2)  898/   90A66 :                     
(2)  899/   90A66 :                     smpsDcb macro
(2)  900/   90A66 :                     		if smpsNotZ80(MOMCPU)
(2)  901/   90A66 :                     			dc.b ALLARGS
(2)  902/   90A66 :                     		else
(2)  903/   90A66 :                     			db ALLARGS
(2)  904/   90A66 :                     		endif
(2)  905/   90A66 :                     	endm
(2)  906/   90A66 :                     
(2)  907/   90A66 :                     ; Voices - Total Level
(2)  908/   90A66 :                     ; The original SMPS2ASM decides TL high bits automatically,
(2)  909/   90A66 :                     ; but later versions leave it up to the user.
(2)  910/   90A66 :                     ; Alternatively, if we're converting an SMPS 68k song to SMPS Z80,
(2)  911/   90A66 :                     ; then we *want* the TL bits to match the algorithm, because SMPS 68k
(2)  912/   90A66 :                     ; prefers the algorithm over the TL bits, ignoring the latter, while
(2)  913/   90A66 :                     ; SMPS Z80 does the opposite.
(2)  914/   90A66 :                     ; Unfortunately, there's nothing we can do if we're trying to convert
(2)  915/   90A66 :                     ; an SMPS Z80 song to SMPS 68k. It will ignore the bits no matter
(2)  916/   90A66 :                     ; what we do, so we just print a warning.
(2)  917/   90A66 :                     smpsVcTotalLevel macro op1,op2,op3,op4
(2)  918/   90A66 :                     	eval vcTL1,op1
(2)  919/   90A66 :                     	eval vcTL2,op2
(2)  920/   90A66 :                     	eval vcTL3,op3
(2)  921/   90A66 :                     	eval vcTL4,op4
(2)  922/   90A66 :                     	smpsDcb	(vcUnusedBits<<6)+(vcFeedback<<3)+vcAlgorithm
(2)  923/   90A66 :                     ;   0     1     2     3     4     5     6     7
(2)  924/   90A66 :                     ;%1000,%1000,%1000,%1000,%1010,%1110,%1110,%1111
(2)  925/   90A66 :                     	if SourceSMPS2ASM==0
(2)  926/   90A66 :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  927/   90A66 :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  928/   90A66 :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  929/   90A66 :                     		eval vcTLMask1,128
(2)  930/   90A66 :                     	else
(2)  931/   90A66 :                     		eval vcTLMask4,0
(2)  932/   90A66 :                     		eval vcTLMask3,0
(2)  933/   90A66 :                     		eval vcTLMask2,0
(2)  934/   90A66 :                     		eval vcTLMask1,0
(2)  935/   90A66 :                     	endif
(2)  936/   90A66 :                     
(2)  937/   90A66 :                     	if (SonicDriverVer>=3)&&(SourceDriver<3)
(2)  938/   90A66 :                     		eval vcTLMask4,((vcAlgorithm==7)<<7)
(2)  939/   90A66 :                     		eval vcTLMask3,((vcAlgorithm>=4)<<7)
(2)  940/   90A66 :                     		eval vcTLMask2,((vcAlgorithm>=5)<<7)
(2)  941/   90A66 :                     		eval vcTLMask1,128
(2)  942/   90A66 :                     		eval vcTL1,vcTL1&127
(2)  943/   90A66 :                     		eval vcTL2,vcTL2&127
(2)  944/   90A66 :                     		eval vcTL3,vcTL3&127
(2)  945/   90A66 :                     		eval vcTL4,vcTL4&127
(2)  946/   90A66 :                     	elseif (SonicDriverVer<3)&&(SourceDriver>=3)&&((((vcTL1|vcTLMask1)&128)<>128)||(((vcTL2|vcTLMask2)&128)<>((vcAlgorithm>=5)<<7))||(((vcTL3|vcTLMask3)&128)<>((vcAlgorithm>=4)<<7))||(((vcTL4|vcTLMask4)&128)<>((vcAlgorithm==7)<<7)))
(2)  947/   90A66 :                     		if MOMPASS=1
(2)  948/   90A66 :                     			message "Voice at 0x\{*} has TL bits that do not match its algorithm setting. This voice will not work in S1/S2 drivers."
(2)  949/   90A66 :                     		endif
(2)  950/   90A66 :                     	endif
(2)  951/   90A66 :                     
(2)  952/   90A66 :                     	if SonicDriverVer==2
(2)  953/   90A66 :                     		smpsDcb	(vcDT4<<4)+vcCF4       ,(vcDT2<<4)+vcCF2       ,(vcDT3<<4)+vcCF3       ,(vcDT1<<4)+vcCF1
(2)  954/   90A66 :                     		smpsDcb	(vcRS4<<6)+vcAR4       ,(vcRS2<<6)+vcAR2       ,(vcRS3<<6)+vcAR3       ,(vcRS1<<6)+vcAR1
(2)  955/   90A66 :                     		smpsDcb	vcAM4|vcD1R4|vcD1R4Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  956/   90A66 :                     		smpsDcb	vcD2R4                 ,vcD2R2                 ,vcD2R3                 ,vcD2R1
(2)  957/   90A66 :                     		smpsDcb	(vcDL4<<4)+vcRR4       ,(vcDL2<<4)+vcRR2       ,(vcDL3<<4)+vcRR3       ,(vcDL1<<4)+vcRR1
(2)  958/   90A66 :                     		smpsDcb	vcTL4|vcTLMask4        ,vcTL2|vcTLMask2        ,vcTL3|vcTLMask3        ,vcTL1|vcTLMask1
(2)  959/   90A66 :                     	else
(2)  960/   90A66 :                     		smpsDcb	(vcDT4<<4)+vcCF4       ,(vcDT3<<4)+vcCF3       ,(vcDT2<<4)+vcCF2       ,(vcDT1<<4)+vcCF1
(2)  961/   90A66 :                     		smpsDcb	(vcRS4<<6)+vcAR4       ,(vcRS3<<6)+vcAR3       ,(vcRS2<<6)+vcAR2       ,(vcRS1<<6)+vcAR1
(2)  962/   90A66 :                     		smpsDcb	vcAM4|vcD1R4|vcD1R4Unk ,vcAM3|vcD1R3|vcD1R3Unk ,vcAM2|vcD1R2|vcD1R2Unk ,vcAM1|vcD1R1|vcD1R1Unk
(2)  963/   90A66 :                     		smpsDcb	vcD2R4                 ,vcD2R3                 ,vcD2R2                 ,vcD2R1
(2)  964/   90A66 :                     		smpsDcb	(vcDL4<<4)+vcRR4       ,(vcDL3<<4)+vcRR3       ,(vcDL2<<4)+vcRR2       ,(vcDL1<<4)+vcRR1
(2)  965/   90A66 :                     		smpsDcb	vcTL4|vcTLMask4        ,vcTL3|vcTLMask3        ,vcTL2|vcTLMask2        ,vcTL1|vcTLMask1
(2)  966/   90A66 :                     	endif
(2)  967/   90A66 :                     	endm
