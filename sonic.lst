    6520/   1723C :                     
    6521/   1723C :                     ; ---------------------------------------------------------------------------
    6522/   1723C :                     ; This subroutine takes 'raw' bitmap-like collision block data as input and
    6523/   1723C :                     ; converts it into the proper collision arrays (ColArray and ColArray2).
    6524/   1723C :                     ; Pointers to said raw data are dummied out.
    6525/   1723C :                     ; Curiously, an example of the original 'raw' data that this was intended
    6526/   1723C :                     ; to process can be found in the J2ME version, in a file called 'blkcol.bct'.
    6527/   1723C :                     ; ---------------------------------------------------------------------------
    6528/   1723C :                     
    6529/   1723C : =$7EE7A              RawColBlocks		equ CollArray1
    6530/   1723C : =$7EE7A              ConvRowColBlocks	equ CollArray1
    6531/   1723C :                     
    6532/   1723C :                     ; ||||||||||||||| S U B R O U T I N E |||||||||||||||||||||||||||||||||||||||
    6533/   1723C :                     
    6534/   1723C :                     
    6535/   1723C :                     ConvertCollisionArray:
    6536/   1723C : 4E75                		rts
    6537/   1723E :                     ; ---------------------------------------------------------------------------
    6538/   1723E :                     		; The raw format stores the collision data column by column for the normal collision array.
    6539/   1723E :                     		; This makes a copy of the data, but stored row by row, for the rotated collision array.
    6540/   1723E : 43F9 0007 EE7A      		lea	(RawColBlocks).l,a1	; Source location of raw collision block data
    6541/   17244 : 45F9 0007 EE7A      		lea	(ConvRowColBlocks).l,a2	; Destinatation location for row-converted collision block data
    6542/   1724A :                     
    6543/   1724A : 363C 00FF           		move.w	#$100-1,d3		; Number of blocks in collision data
    6544/   1724E :                     
    6545/   1724E :                     .blockLoop:
    6546/   1724E : 7A10                		moveq	#16,d5			; Start on the 16th bit (the leftmost pixel)
    6547/   17250 :                     
    6548/   17250 : 343C 000F           		move.w	#16-1,d2		; Width of a block in pixels
    6549/   17254 :                     
    6550/   17254 :                     .columnLoop:
    6551/   17254 : 7800                		moveq	#0,d4
    6552/   17256 :                     
    6553/   17256 : 323C 000F           		move.w	#16-1,d1		; Height of a block in pixels
    6554/   1725A :                     
    6555/   1725A :                     .rowLoop:
    6556/   1725A : 3019                		move.w	(a1)+,d0		; Get row of collision bits
    6557/   1725C : EAA8                		lsr.l	d5,d0			; Push the selected bit of this row into the 'eXtend' flag
    6558/   1725E : D944                		addx.w	d4,d4			; Shift d4 to the left, and insert the selected bit into bit 0
    6559/   17260 : 51C9 FFF8           		dbf	d1,.rowLoop		; Loop for each row of pixels in a block
    6560/   17264 :                     
    6561/   17264 : 34C4                		move.w	d4,(a2)+		; Store column of collision bits
    6562/   17266 : 92FC 0020           		suba.w	#2*16,a1		; Back to the start of the block
    6563/   1726A : 5345                		subq.w	#1,d5			; Get next bit in the row
    6564/   1726C : 51CA FFE6           		dbf	d2,.columnLoop		; Loop for each column of pixels in a block
    6565/   17270 :                     
    6566/   17270 : D2FC 0020           		adda.w	#2*16,a1		; Next block
    6567/   17274 : 51CB FFD8           		dbf	d3,.blockLoop		; Loop for each block in the raw collision block data
    6568/   17278 :                     
