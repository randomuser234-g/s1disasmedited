     304/     2CA :                     
     305/     2CA :                     		; Z80 instructions (not the sound driver; that gets loaded later)
     306/     2CA :                     		save
     307/     2CA :                     		CPU Z80 ; start assembling Z80 code
     308/       0 :                     		phase 0 ; pretend we're at address 0
     309/       0 : AF                  		xor	a	; clear a to 0
     310/       1 : 01 D9 1F            		ld	bc,((z80_ram_end-z80_ram)-zStartupCodeEndLoc)-1 ; prepare to loop this many times
     311/       4 : 11 27 00            		ld	de,zStartupCodeEndLoc+1	; initial destination address
     312/       7 : 21 26 00            		ld	hl,zStartupCodeEndLoc	; initial source address
     313/       A : F9                  		ld	sp,hl	; set the address the stack starts at
     314/       B : 77                  		ld	(hl),a	; set first byte of the stack to 0
     315/       C : ED B0               		ldir		; loop to fill the stack (entire remaining available Z80 RAM) with 0
     316/       E : DD E1               		pop	ix	; clear ix
     317/      10 : FD E1               		pop	iy	; clear iy
     318/      12 : ED 47               		ld	i,a	; clear i
     319/      14 : ED 4F               		ld	r,a	; clear r
     320/      16 : D1                  		pop	de	; clear de
     321/      17 : E1                  		pop	hl	; clear hl
     322/      18 : F1                  		pop	af	; clear af
     323/      19 : 08                  		ex	af,af'	; swap af with af'
     324/      1A : D9                  		exx		; swap bc/de/hl with their shadow registers too
     325/      1B : C1                  		pop	bc	; clear bc
     326/      1C : D1                  		pop	de	; clear de
     327/      1D : E1                  		pop	hl	; clear hl
     328/      1E : F1                  		pop	af	; clear af
     329/      1F : F9                  		ld	sp,hl	; clear sp
     330/      20 : F3                  		di		; clear iff1 (for interrupt handler)
     331/      21 : ED 56               		im	1	; interrupt handling mode = 1
     332/      23 : 36 E9               		ld	(hl),0E9h ; replace the first instruction with a jump to itself
     333/      25 : E9                  		jp	(hl)	  ; jump to the first instruction (to stay there forever)
     334/      26 :                     zStartupCodeEndLoc:
     335/     2F0 :                     		dephase ; stop pretending
     336/     2F0 : ALL                  		restore
     337/     2F0 :                     		padding off ; unfortunately our flags got reset so we have to set them again...
